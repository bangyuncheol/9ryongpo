# 9ryongpo 환경 변수 예시. 이 파일을 .env 로 복사한 뒤 빈 값을 채운다.
# 비밀 값은 .env 에만 넣고, 이 파일에는 공개돼도 되는 값만 둔다.
# 실제 비밀 값은 팀 내부의 안전한 경로로 공유한다.

# --- 외부 API (비밀) ---
# E-UM 디지털트윈 포항: pohang-eum.kr 마이페이지 > 나의 API
EUM_SERVICE_KEY=
# 공공데이터포털(해수부 일자별 위탁판매현황): data.go.kr 마이페이지 > 인증키 발급현황
DATA_GO_KR_KEY=
# OpenAI (대회 지원 크레딧)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6.1-sol
# 카카오 REST API 키(장소 검색·자동차 길찾기, 서버 전용). 지도용 VITE_KAKAO_MAP_KEY 와 같은 앱의 'REST API 키'. 앞에 VITE_ 를 붙이지 않는다
KAKAO_REST_KEY=

# --- 웹 푸시 VAPID ---
# 공개 키는 브라우저에 그대로 전달되는 값이라 공개돼도 된다.
# 비밀 키는 팀 공용 값을 받아 넣는다. 팀원마다 다른 키를 만들면 서로의 구독에 알림을 보낼 수 없다.
VAPID_PUBLIC_KEY=BKDU_YeZCFzBYtDnsfVSjQfQT8lotVtoZ-O3Pu_Cbd6PrIG7ZQMhktQFj-zZvaX3B_tkq2vyOgdeKkcJ7Ti0MTc
VAPID_PRIVATE_KEY=
# 푸시 서비스가 문제 시 연락할 주소. 형식: mailto:주소 (등호 뒤 공백 없이)
VAPID_SUBJECT=

# --- 카카오맵 JavaScript 키 (화면에 들어가는 공개 키, 등록 도메인에서만 동작) ---
# Kakao Developers > 앱 > 플랫폼 키 > JavaScript 키. JavaScript SDK 도메인에 localhost:8000·5173·운영 도메인 등록,
# [카카오맵] 사용 설정 ON. 비우면 기존 지도(Leaflet+OpenStreetMap)로 동작한다.
VITE_KAKAO_MAP_KEY=

# --- 전화 알림 (설계 §4.3). PHONE_ENABLED=1 인 서버 하나만 켠다(번호당 연결 하나, 로컬·VM 동시 금지) ---
PHONE_ENABLED=0
# ClawOps 콘솔 > 개발자 > API 키 (비밀)
CLAWOPS_API_KEY=
CLAWOPS_ACCOUNT_ID=
# 발급받은 070 번호(비밀 아님, 숫자만)
CLAWOPS_FROM_NUMBER=
# 전화를 걸 수 있는 번호(시연용 허용 목록, 쉼표 구분)
CALL_ALLOWED_NUMBERS=
# Gemini API 키(비밀, 하루 100회 한도) — 전화 음성 합성
GEMINI_API_KEY=
# CLOVA Speech(Nest) 비밀 키 — 전화 받아쓰기. 비우면 OpenAI 받아쓰기만 쓴다
CLOVA_SECRET_KEY=
# 1이면 전화 질문 음성을 data/stt_clips/에 저장(STT 비교 시험용, 본인 목소리로만, 시험 뒤 삭제)
STT_RECORD=0

# --- 실행 설정 (비밀 아님) ---
# sim: 시뮬레이터 재생, live: E-UM 실제 선박 위치
FEED=sim
DB_PATH=./data/app.db

# --- 배포 VM 전용 ---
# Cloudflare 대시보드에서 만든 터널 토큰. 있으면 bmj.kr 고정 주소, 없으면 임시 주소(로컬 개발엔 불필요)
TUNNEL_TOKEN=
