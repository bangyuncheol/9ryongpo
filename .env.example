# 9ryongpo 환경 변수 예시. 이 파일을 .env 로 복사한 뒤 빈 값을 채운다.
# 비밀 값은 .env 에만 넣고, 이 파일에는 공개돼도 되는 값만 둔다.
# 실제 비밀 값은 팀 내부의 안전한 경로로 공유한다.

# --- 외부 API (비밀) ---
# E-UM 디지털트윈 포항: pohang-eum.kr 마이페이지 > 나의 API
EUM_SERVICE_KEY=
# 공공데이터포털(해수부 일자별 위탁판매현황): data.go.kr 마이페이지 > 인증키 발급현황
DATA_GO_KR_KEY=
# OpenAI (대회 지원 크레딧)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6.1-sol

# --- 웹 푸시 VAPID ---
# 공개 키는 브라우저에 그대로 전달되는 값이라 공개돼도 된다.
# 비밀 키는 팀 공용 값을 받아 넣는다. 팀원마다 다른 키를 만들면 서로의 구독에 알림을 보낼 수 없다.
VAPID_PUBLIC_KEY=BKDU_YeZCFzBYtDnsfVSjQfQT8lotVtoZ-O3Pu_Cbd6PrIG7ZQMhktQFj-zZvaX3B_tkq2vyOgdeKkcJ7Ti0MTc
VAPID_PRIVATE_KEY=
# 푸시 서비스가 문제 시 연락할 주소. 형식: mailto:주소 (등호 뒤 공백 없이)
VAPID_SUBJECT=

# --- 시뮬레이터 시계 조작·데이터 소스 전환 API 관리자 토큰 (비밀) ---
SIM_ADMIN_TOKEN=

# --- 실행 설정 (비밀 아님) ---
# sim: 시뮬레이터 재생, live: E-UM 실제 선박 위치
FEED=sim
DB_PATH=./data/app.db
